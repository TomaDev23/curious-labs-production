{
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm install",
    "redirects": [
      { "source": "/Maestro", "destination": "/maestro", "permanent": false },
      { "source": "/Maestro/", "destination": "/maestro", "permanent": false },
      { "source": "/Maestro/index.html", "destination": "/maestro", "permanent": false }
    ],
    "rewrites": [
      { "source": "/maestro", "destination": "/maestro/index.html" },
      { "source": "/maestro/", "destination": "/maestro/index.html" },
      { "source": "/Maestro", "destination": "/maestro/index.html" },
      { "source": "/Maestro/", "destination": "/maestro/index.html" },
      { "source": "/(.*)", "destination": "/" }
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "headers": [
      {
        "source": "/(.*)\\.(png|jpg|jpeg|svg|gif|webp|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/(.*)",
        "headers": [
          { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
          { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-eval' 'sha256-8m8C91+VvYgC1kiCTFiGDyFUoH+cPu/BFgT15i1RJok=' 'sha256-aTXL2ewkCseutSogGzR/n1OoF43563AxVklkWJSBV64=' vercel.live *.vercel-insights.com blob:; style-src 'self' 'unsafe-inline' fonts.googleapis.com; img-src * blob: data:; font-src 'self' fonts.gstatic.com; connect-src 'self' vercel.live *.vercel-insights.com" }
        ]
      }
    ]
  }
  
